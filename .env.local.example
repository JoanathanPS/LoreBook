# ---- Supabase (required) ----
# Project URL and anon key from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Ingest worker (required for uploads to be processed) ----
# Service-role key (Supabase > Project Settings > API > service_role). Used
# ONLY on the server by the ingest worker (lib/supabase/admin.ts), which
# bypasses RLS. Never expose it to the browser: no NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret protecting /api/ingest/tick (sent as "Authorization: Bearer
# <CRON_SECRET>"). Vercel Cron sends it automatically when it is set in the
# project. Generate one with: openssl rand -hex 32
CRON_SECRET=

# ---- Groq (required) ----
# Chat, RAG answers, all study-material generation, and audio/video
# transcription. Free tier: https://console.groq.com
GROQ_API_KEY=

# ---- Google AI (recommended) ----
# Embeddings (gemini-embedding-001, 768d) and reading images/diagrams/
# handwriting (gemini-2.5-flash). Free tier:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Voyage AI (optional) ----
# Fallback embedding provider, used only when GEMINI_API_KEY is unset.
VOYAGE_API_KEY=

# ---- Site URL (optional) ----
# Base URL used for auth email redirects. Defaults to http://localhost:3000.
# Set this to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=
